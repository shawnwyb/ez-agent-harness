# Global keys live in ~/.ez-agent/auth.json (Pi-style). Not cwd.
# {
#   "xai": { "type": "api_key", "key": "xai-..." },
#   "anthropic": { "type": "api_key", "key": "sk-ant-..." }
# }
# chmod 600 ~/.ez-agent/auth.json
#
# Fallback: export XAI_API_KEY, or put the same vars in ~/.ez-agent/.env
# MODEL overrides .ez-agent/settings.json for this process only.
# Use /model default in the REPL to persist a startup default.
XAI_API_KEY=xai-...
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=xai/grok-4.6
