# Global keys live in ~/.ez-agent/auth.json (Pi-style). Not cwd.
# {
#   "xai": { "type": "api_key", "key": "xai-..." },
#   "anthropic": { "type": "api_key", "key": "sk-ant-..." }
# }
# chmod 600 ~/.ez-agent/auth.json
#
# Fallback: export XAI_API_KEY, or put the same vars in ~/.ez-agent/.env
# Sessions: ~/.ez-agent/sessions/--<cwd-with-dashes>--/
# /model default writes settings.json in that same dir (not in the project).
# MODEL overrides that settings.json for this process only.
XAI_API_KEY=xai-...
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=xai/grok-4.6
